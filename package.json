{
  "name": "tummy-time",
  "private": true,
  "version": "0.0.0",
  "description": "Tummy Time: a learning app for caregivers of babies born early.",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.23.4 <23"
  },
  "scripts": {
    "build:shared": "pnpm --filter @tummy/shared build",
    "dev": "pnpm build:shared && pnpm --parallel --filter @tummy/api --filter @tummy/web dev",
    "lint": "pnpm build:shared && eslint . --max-warnings=0 && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "pnpm build:shared && pnpm -r --workspace-concurrency=1 typecheck",
    "test": "pnpm build:shared && pnpm -r --workspace-concurrency=1 test",
    "test:e2e": "pnpm build:shared && pnpm --filter @tummy/web test:e2e",
    "build": "pnpm -r build",
    "check:size": "node scripts/check-bundle-size.mjs && node scripts/check-no-styleguide.mjs",
    "db:migrate": "pnpm --filter @tummy/api db:migrate",
    "db:seed": "pnpm --filter @tummy/api db:seed",
    "db:reset": "pnpm --filter @tummy/api db:reset",
    "prepare": "simple-git-hooks",
    "docker:up": "docker compose --env-file .env -f infra/docker-compose.yml up --build",
    "db:up": "docker compose --env-file .env -f infra/docker-compose.yml -f infra/docker-compose.dev.yml up -d db"
  },
  "simple-git-hooks": {
    "pre-commit": "sh scripts/pre-commit.sh"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "eslint --max-warnings=0",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css,html}": "prettier --write"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-security": "4.2.1",
    "globals": "17.14.0",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "simple-git-hooks": "2.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2"
  },
  "pnpm": {
    "overrides": {
      "@typescript-eslint/typescript-estree>minimatch": "11.0.1",
      "@esbuild-kit/core-utils>esbuild": "0.25.12"
    }
  }
}
