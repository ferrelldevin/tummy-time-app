{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "types": ["vite/client", "node"],
    "noEmit": true,
    // vite.config.ts imports its helper plugins with their .ts extension, which Vite's own
    // config loader asks for. Allowed only because nothing here is emitted by tsc.
    "allowImportingTsExtensions": true
  },
  "include": ["src", "e2e", "tooling", "vite.config.ts", "playwright.config.ts"]
}
