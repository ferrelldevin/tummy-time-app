# Access log without the client's network address (docs/data-map.md, "In logs").
log_format tummy '$request_method $uri $status $request_time';

server {
  listen 80;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;
  # Do not tell visitors which nginx version this is.
  server_tokens off;
  # Our text files are UTF-8; say so in Content-Type.
  charset utf-8;
  access_log /var/log/nginx/access.log tummy;

  # Same-origin API: the browser only ever talks to this server.
  # The API sets its own security headers (CSP, HSTS, nosniff, frame denial, referrer policy,
  # no-store); nginx passes them through untouched and adds none of its own to API answers.
  location /api/ {
    proxy_pass http://api:${API_PORT};
    # Replace, never append, so a client cannot plant a fake address for the rate limiter.
    # The API reads it with API_TRUST_PROXY_HOPS=1 and keeps it in memory only.
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header Host $host;
  }

  # The page and its files. Their security headers are in nginx-security-headers.conf, included
  # in each location below (nginx forgets inherited add_header lines in a location that adds
  # its own). The API sets its own, above.
  #
  # HTTP caching (Block 7). The service worker keeps the app's files on the phone; these rules
  # make sure a new version is seen as soon as it is deployed:
  # - Hashed build files (/assets/) never change under the same name: cached for a year.
  #   A file that is not there is a 404, never the page, so an old version asking for a file
  #   that is gone fails plainly instead of getting HTML.
  # - Everything else (sw.js, index.html, the manifest, workbox-*.js, icons) is "no-cache":
  #   the browser may keep it but must ask this server first, every time. sw.js above all:
  #   if it were cached, phones would not hear about a new version.
  # Cache-Control is left off error answers (no "always"), so a 404 is never cached for a year.
  #
  # Run in Docker during the Block 8 review: "nginx -t" passes, and every header was read with
  # curl on /, /sw.js, the manifest, an icon, a hashed file and a missing file. Not yet read on a
  # real server (docs/runbook.md, section 11, has the commands).
  location /assets/ {
    include /etc/nginx/snippets/tummy-security-headers.conf;
    add_header Cache-Control "public, max-age=31536000, immutable";
    try_files $uri =404;
  }

  location = /manifest.webmanifest {
    include /etc/nginx/snippets/tummy-security-headers.conf;
    add_header Cache-Control "no-cache";
    # Not every nginx mime.types lists .webmanifest; say what it is here only.
    types { }
    default_type application/manifest+json;
  }

  location / {
    include /etc/nginx/snippets/tummy-security-headers.conf;
    add_header Cache-Control "no-cache";
    try_files $uri /index.html;
  }
}
