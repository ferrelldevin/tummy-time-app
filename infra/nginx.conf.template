# Access log without the client's network address (docs/data-map.md, "In logs").
log_format tummy '$request_method $uri $status $request_time';

server {
  listen 80;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;
  access_log /var/log/nginx/access.log tummy;

  # Same-origin API: the browser only ever talks to this server.
  # The API sets its own security headers (CSP, HSTS, nosniff, frame denial, referrer policy,
  # no-store); nginx passes them through untouched and adds none of its own to API answers.
  location /api/ {
    proxy_pass http://api:${API_PORT};
    # Replace, never append, so a client cannot plant a fake address for the rate limiter.
    # The API reads it with API_TRUST_PROXY_HOPS=1 and keeps it in memory only.
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header Host $host;
  }

  # The page and its files. These headers are the page's own; the API sets its own above.
  # - Content-Security-Policy: scripts, styles, images and requests only from this server.
  #   No inline script, no plugins, no framing, no <base> tricks.
  # - Strict-Transport-Security only takes effect over HTTPS, which arrives with the real
  #   certificate in Block 8. Browsers ignore it over plain HTTP, so it is safe to send now.
  # Not yet seen running in a container (no Docker where this was written): Block 8 checks them.
  location / {
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; media-src 'self'; connect-src 'self'; font-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'" always;
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Cross-Origin-Opener-Policy "same-origin" always;
    try_files $uri /index.html;
  }
}
