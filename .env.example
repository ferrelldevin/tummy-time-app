# Copy to .env and fill in. Never commit .env. Every variable the project reads is listed here.

# Do not put NODE_ENV in this file: the web build reads it too, and NODE_ENV=development here
# would turn the production build into a development build. Set it on the command line when a
# command needs it, for example `NODE_ENV=development pnpm db:reset`.

# API (apps/api). API_PORT is required; the API refuses to start without it.
API_PORT=3001
API_HOST=127.0.0.1
# One of: fatal, error, warn, info, debug, trace, silent
LOG_LEVEL=info
# Reverse proxies in front of the API: 0 on your machine, 1 behind the nginx in infra/.
API_TRUST_PROXY_HOPS=0

# Sign-in (apps/api). The API refuses to start without CODE_LOOKUP_SECRET and APP_ORIGIN.
# CODE_LOOKUP_SECRET is the key for the keyed hash of family codes: at least 32 random bytes,
# written in base64. Make your own with one of these and paste it after the = sign:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
#   openssl rand -base64 32
# Never commit it, never share it, never use the same one on two servers. If it changes,
# no family code made before can be found again.
CODE_LOOKUP_SECRET=
# The app's own address as the browser sees it: scheme, host and port, no path, no trailing
# slash. Requests that change something must come from exactly this origin. With `pnpm dev`
# it is the Vite address below. On the server it is the real https address.
APP_ORIGIN=http://127.0.0.1:5173
# family-code-pin (the default) or dev-fake. dev-fake signs in with the family code alone and
# runs only when NODE_ENV is development or test, set on the command line.
AUTH_PROVIDER=family-code-pin

# Web dev server (apps/web). The address is only used on your own machine. If you change it,
# change APP_ORIGIN to match.
WEB_PORT=5173
# Optional. The port the containers' web server (`pnpm docker:up`) is published on, at http://127.0.0.1:<port>. Default 8080.
# DOCKER_WEB_PORT=8080

# Database (docs/runbook.md shows how to create the users and the database).
# Two users: the app user can only read and write rows; the migrator user owns the tables.
# Make up your own passwords. Leave nothing real in git.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=tummy_time
DB_APP_USER=tummy_app
DB_APP_PASSWORD=
DB_MIGRATOR_USER=tummy_migrator
DB_MIGRATOR_PASSWORD=

# Database container administrator (infra/docker-compose.yml only). Make up your own values.
POSTGRES_USER=
POSTGRES_PASSWORD=

# ---------------------------------------------------------------------------------------------
# Production server only (infra/docker-compose.prod.yml). On a server this file is copied to
# infra/.env, mode 600, and every line above is filled in with that server's own values:
# APP_ORIGIN is the real https address (no port, no path), API_HOST and API_TRUST_PROXY_HOPS are
# set by the compose file and ignored there, and AUTH_PROVIDER is fixed to family-code-pin by
# the compose file. DB_HOST and DB_PORT are also set by the compose file. docs/runbook.md,
# "First-time server setup", has the steps. infra/deploy.sh refuses to run if infra/.env is
# missing or readable by anyone else.
# ---------------------------------------------------------------------------------------------

# The DNS name of the server, the same name as in APP_ORIGIN. Caddy (infra/Caddyfile) makes its
# HTTPS certificate for this name. Example of the shape only: tummytime.example.org
SITE_ADDRESS=

# Set to "test" ONLY for a test site. The web app is then built with a strip on every screen that
# says "Test site. Sample data." It is read when the app is built (a build argument in the
# compose file), never at run time. Empty means off. Any other value stops the build. A test
# site must hold made-up data only.
SITE_BANNER=

# A folder on the SERVER'S disk for database backups, as a full path such as /srv/tummy-backups.
# It must exist, belong to the deploy user, and be OUTSIDE Docker's own storage. Backups are
# unencrypted copies of every family's logs: see infra/backup-scheduled.sh. Never inside the repo.
BACKUP_DIR=
# How many days backups are kept before the scheduled backup deletes them. 7 or more.
BACKUP_KEEP_DAYS=30

# How many seconds infra/deploy.sh waits for /api/health to answer after starting a new version
# before it goes back to the old one. 10 or more.
HEALTH_TIMEOUT_SECONDS=120

# Only when the site's certificate does not come from a public authority: the full path of the
# authority's certificate file, so infra/deploy.sh can still verify HTTPS when it checks health.
# Needed for a practice run on your own computer (docs/runbook.md, "Practice on your own
# computer"). Leave empty on a normal server.
HEALTH_CA_FILE=

# Not in this file on purpose: TUMMY_VERSION (which version to run) is set by infra/deploy.sh,
# and TUMMY_BUILD_ID (the commit shown in the page's tummy-build tag) is set by it too.
# For infra/healthcheck.sh, which runs on ANOTHER machine, not the server:
#   HEALTH_URL=https://your-site-name/api/health
