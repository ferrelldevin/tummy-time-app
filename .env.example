# Copy to .env and fill in. Never commit .env. Every variable the project reads is listed here.

# Do not put NODE_ENV in this file: the web build reads it too, and NODE_ENV=development here
# would turn the production build into a development build. Set it on the command line when a
# command needs it, for example `NODE_ENV=development pnpm db:reset`.

# API (apps/api). API_PORT is required; the API refuses to start without it.
API_PORT=3001
API_HOST=127.0.0.1
# One of: fatal, error, warn, info, debug, trace, silent
LOG_LEVEL=info
# Reverse proxies in front of the API: 0 on your machine, 1 behind the nginx in infra/.
API_TRUST_PROXY_HOPS=0

# Web dev server (apps/web). The address is only used on your own machine.
WEB_PORT=5173

# Database (docs/runbook.md shows how to create the users and the database).
# Two users: the app user can only read and write rows; the migrator user owns the tables.
# Make up your own passwords. Leave nothing real in git.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=tummy_time
DB_APP_USER=tummy_app
DB_APP_PASSWORD=
DB_MIGRATOR_USER=tummy_migrator
DB_MIGRATOR_PASSWORD=

# Database container administrator (infra/docker-compose.yml only). Make up your own values.
POSTGRES_USER=
POSTGRES_PASSWORD=
